{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/host-watcher/hooks/claude-code/host-pressure-reminder.cjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/host-watcher/hooks/claude-code/host-pressure-reminder.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
